# Telegram bot (create via @BotFather)
BOT_TOKEN=123456:ABC-your-bot-token

# Your personal Telegram user ID. The bot sends review drafts only to this ID.
ADMIN_USER_ID=123456789

# Target Telegram channel for approved posts. Add the bot as channel admin.
PUBLISH_CHANNEL_ID=@your_channel

# Keep private for local development. Public mode requires WEB_AUTH_MODE=required
# and HTTPS (WEB_COOKIE_SECURE=true).
WEB_ACCESS_MODE=private
# Keep off for the local owner-only MVP. Set to required after deploying auth-aware UI.
WEB_AUTH_MODE=off
WEB_COOKIE_SECURE=false
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Optional backup Gemini API key, used only when primary Groq is unavailable.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
LLM_MODEL=gemini-flash-lite-latest
LLM_MIN_REQUEST_INTERVAL_SECONDS=13
LLM_MAX_RATE_RETRIES=2

# Primary free Groq provider for filtering, drafts, and manual Rework.
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MIN_REQUEST_INTERVAL_SECONDS=2.1
GROQ_MAX_RATE_RETRIES=2
FILTER_MIN_SCORE=4.0
FILTER_VERSION=2
ENABLE_IMAGE_DISCOVERY=true
ENABLE_SOCIAL_CARD_GENERATION=true
SOCIAL_CARD_DIRECTORY=images/generated
SOCIAL_CARD_MASCOT_PATH=images/brand/anime-ninja-mascot.png
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4
ENABLE_PROJECT_LINK_DISCOVERY=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./airdrop_bot.db

# Serverless Telegram webhook (Vercel deployment only). WEBHOOK_URL ends in /api.
# Generate TELEGRAM_WEBHOOK_SECRET with a password manager; do not commit it.
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_URL=

# Free source scanning
SOURCE_SCAN_INTERVAL_MINUTES=60
SOURCE_COLLECTION_TIMEOUT_SECONDS=120
SIGNAL_PROCESS_TIMEOUT_SECONDS=180
JOB_WORKER_INTERVAL_SECONDS=2
JOB_MAX_ATTEMPTS=3
CLEANUP_INTERVAL_HOURS=24
JOB_RETENTION_DAYS=30
REVIEW_REQUEST_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=180
RUN_SCAN_ON_START=true
ENABLE_AIRDROPALERT_SOURCE=true
ENABLE_RSS_SOURCE=true
ENABLE_TRUSTED_X_SOURCE=true
ENABLE_FREE_X_FALLBACK=true
# Active airdrop/testnet feed. Do not use the general blog feed.
AIRDROPALERT_FEED_URL=https://airdropalert.com/feed/rssfeed
RSS_FEEDS=https://cryptonews.com/feed/,https://www.theblock.co/rss.xml,https://www.coindesk.com/arc/outboundfeeds/rss/
TRUSTED_X_ACCOUNTS=airdropalertcom,arbitrum,optimismFND,Starknet,zksync
FREE_X_RSS_BASE_URLS=https://nitter.net,https://xcancel.com

# Instagram is optional. Graph API has no per-call charge, but feed posts need a public image URL.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# X/Twitter direct publishing (OAuth 1.0a user context).
# If credentials are absent or publishing fails, the bot sends an Open in X button.
X_API_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_AUTO_PUBLISH=true
WEB_SECRET_KEY=replace-with-a-long-random-secret-before-saving-user-credentials
